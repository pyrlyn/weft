<!-- An unknown element holding known children and a named slot: both stay readable. -->
<screen id="s" label="Compat" weft="0.3">
  <stack id="st">
    <carousel id="car" autoplay="true">
      <text id="intro">Pick one</text>
      <button id="next">Next</button>
      <slot name="controls">
        <button id="prev">Previous</button>
      </slot>
    </carousel>
  </stack>
</screen>
