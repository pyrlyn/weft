<Page x:Class="WeftScreens.TokensPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="Weft.material.glass" TintColor="#FFFFFFFF" TintOpacity="0.28" FallbackColor="#47FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="Weft.material.glass" TintColor="#FFFFFFFF" TintOpacity="0.28" FallbackColor="#47FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="Weft.material.glass" Color="#47FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="Weft.space.sm">8</x:Double>
            <Thickness x:Key="Weft.space.sm.thickness">8</Thickness>
            <x:Double x:Key="Weft.space.md">16</x:Double>
            <Thickness x:Key="Weft.space.md.thickness">16</Thickness>
            <x:Double x:Key="Weft.space.lg">24</x:Double>
            <Thickness x:Key="Weft.space.lg.thickness">24</Thickness>
            <x:Double x:Key="Weft.size.sm">240</x:Double>
            <Thickness x:Key="Weft.size.sm.thickness">240</Thickness>
            <x:Double x:Key="Weft.size.md">480</x:Double>
            <Thickness x:Key="Weft.size.md.thickness">480</Thickness>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="tokens" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Tokens">
            <Border Background="{ThemeResource Weft.material.glass}" Padding="{StaticResource Weft.space.lg.thickness}" MaxWidth="{StaticResource Weft.size.md}">
                <StackPanel AutomationProperties.AutomationId="card" Spacing="{StaticResource Weft.space.md}">
                    <TextBlock AutomationProperties.AutomationId="card-text" TextWrapping="Wrap" Text="Own tokens" />
                </StackPanel>
            </Border>
            <weft:ColumnsPanel AutomationProperties.AutomationId="cells" Columns="2" MinColumnWidth="{StaticResource Weft.size.sm}" Spacing="{StaticResource Weft.space.sm}">
                <TextBlock AutomationProperties.AutomationId="cell-a" TextWrapping="Wrap" Text="A" />
                <TextBlock AutomationProperties.AutomationId="cell-b" TextWrapping="Wrap" Text="B" />
            </weft:ColumnsPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
