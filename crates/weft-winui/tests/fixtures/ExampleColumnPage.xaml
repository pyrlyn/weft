<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleColumn namespace=WeftScreens
<screen id="root" label="Users" weft="0.1">
  <table id="users" label="Users">
    <column id="col-name" sort="ascending" on-press="users.sortByName">Name</column>
    <column id="col-role" sort="none">Role</column>
  </table>
</screen>
-->
<Page x:Class="WeftScreens.ExampleColumnPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Users">
            <StackPanel AutomationProperties.AutomationId="users" AutomationProperties.LocalizedControlType="table" AutomationProperties.Name="Users">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="col-name" AutomationProperties.LocalizedControlType="column header" Content="Name" weft:Props.Sort="ascending" weft:On.Press="{x:Bind ViewModel.users_sortByNameCommand}" />
                    <Button AutomationProperties.AutomationId="col-role" AutomationProperties.LocalizedControlType="column header" Content="Role" weft:Props.Sort="none" Grid.Column="1" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
