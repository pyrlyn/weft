<Page x:Class="WeftScreens.CorpusConfirmDialogPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="files" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="File">
            <TextBlock AutomationProperties.AutomationId="title" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Quarterly report" />
            <Button AutomationProperties.AutomationId="delete-file" Content="Delete file" weft:Props.Variant="danger" weft:On.Press="{x:Bind ViewModel.dialog_openCommand}" />
            <ContentDialog AutomationProperties.AutomationId="confirm" weft:Dialog.IsOpen="{x:Bind ViewModel.confirmOpen, Mode=TwoWay}" AutomationProperties.Name="Delete file?" weft:On.Close="{x:Bind ViewModel.dialog_closeCommand}">
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="warning" TextWrapping="Wrap" Text="This cannot be undone." />
                    <TextBlock AutomationProperties.AutomationId="filename" TextWrapping="Wrap" Text="{x:Bind ViewModel.file.name, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" weft:Slot.Name="actions">
                        <Button AutomationProperties.AutomationId="cancel" Content="Cancel" weft:On.Press="{x:Bind ViewModel.dialog_closeCommand}" />
                        <Button AutomationProperties.AutomationId="confirm-delete" Content="Delete" weft:Props.Variant="danger" weft:On.Press="{x:Bind ViewModel.file_deleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </ContentDialog>
        </StackPanel>
    </ScrollViewer>
</Page>
