<Page x:Class="WeftScreens.CorpusAccountPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="account" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Edit account">
            <TextBlock AutomationProperties.AutomationId="title" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Edit account" />
            <StackPanel AutomationProperties.AutomationId="account-form" AutomationProperties.LandmarkType="Form" AutomationProperties.Name="Account" weft:Props.State="invalid" weft:On.Submit="{x:Bind ViewModel.account_saveCommand}">
                <TextBox AutomationProperties.AutomationId="name" Text="{x:Bind ViewModel.account.name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ada Lovelace" Header="Full name" weft:Props.State="valid" weft:On.Change="{x:Bind ViewModel.account_editCommand}" />
                <TextBox AutomationProperties.AutomationId="age" Text="{x:Bind ViewModel.account.age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" weft:Props.Error="{x:Bind ViewModel.errors.age, Mode=OneWay}" Header="Age" weft:Props.State="invalid" />
                <TextBox AutomationProperties.AutomationId="handle" Text="{x:Bind ViewModel.account.handle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{}{handle}" IsEnabled="{x:Bind weft:Weft.Not(ViewModel.account.locked), Mode=OneWay}" Header="Handle" />
                <TextBox AutomationProperties.AutomationId="bio" Text="{x:Bind ViewModel.account.bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Header="Bio" />
                <TextBox AutomationProperties.AutomationId="email" Text="{x:Bind ViewModel.account.email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="EmailSmtpAddress" IsEnabled="False" Header="Email" />
                <CheckBox AutomationProperties.AutomationId="newsletter" IsChecked="{x:Bind ViewModel.account.newsletter, Mode=TwoWay}" Content="Send me the newsletter" weft:On.Change="{x:Bind ViewModel.account_editCommand}" />
                <CheckBox AutomationProperties.AutomationId="terms" IsChecked="True" IsEnabled="False" Content="Terms accepted" />
                <ToggleSwitch AutomationProperties.AutomationId="public" IsOn="{x:Bind ViewModel.account.public_, Mode=TwoWay}" IsEnabled="{x:Bind weft:Weft.Truthy(ViewModel.account.verified), Mode=OneWay}" Header="Public profile" weft:On.Change="{x:Bind ViewModel.account_editCommand}" />
                <RadioButtons AutomationProperties.AutomationId="plan" weft:Choice.Value="{x:Bind ViewModel.account.plan, Mode=TwoWay}" Header="Plan" weft:On.Change="{x:Bind ViewModel.account_editCommand}">
                    <RadioButton AutomationProperties.AutomationId="plan-free" Content="Free" Tag="free" />
                    <RadioButton AutomationProperties.AutomationId="plan-pro" Content="{x:Bind ViewModel.labels.pro, Mode=OneWay}" Tag="pro" />
                    <RadioButton AutomationProperties.AutomationId="plan-team" Content="Team" Tag="team" IsEnabled="False" />
                </RadioButtons>
                <ComboBox AutomationProperties.AutomationId="language" weft:Choice.Value="{x:Bind ViewModel.account.language, Mode=TwoWay}" IsEnabled="{x:Bind weft:Weft.Not(ViewModel.account.locked), Mode=OneWay}" Header="Language" weft:On.Change="{x:Bind ViewModel.account_editCommand}">
                    <ComboBoxItem AutomationProperties.AutomationId="language-en" Content="English" Tag="en" />
                    <ComboBoxItem AutomationProperties.AutomationId="language-fr" Content="{x:Bind ViewModel.labels.french, Mode=OneWay}" Tag="fr" />
                </ComboBox>
                <TextBlock AutomationProperties.AutomationId="internal" TextWrapping="Wrap" Text="Internal note: never shown." Visibility="Collapsed" />
                <InfoBar AutomationProperties.AutomationId="saved" IsOpen="True" IsClosable="False" Severity="Success" Message="Your changes were saved." Visibility="{x:Bind ViewModel.saved, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" weft:Slot.Name="footer">
                    <Button AutomationProperties.AutomationId="save" Content="Save" Style="{StaticResource AccentButtonStyle}" weft:On.Submit="{x:Bind ViewModel.account_saveCommand}" weft:Props.State="busy" />
                    <Button AutomationProperties.AutomationId="cancel" Content="{x:Bind ViewModel.labels.cancel, Mode=OneWay}" weft:Props.State="idle" weft:On.Press="{x:Bind ViewModel.account_cancelCommand}" />
                    <HyperlinkButton AutomationProperties.AutomationId="help" Content="{x:Bind ViewModel.labels.help, Mode=OneWay}" NavigateUri="https://example.com/help" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
