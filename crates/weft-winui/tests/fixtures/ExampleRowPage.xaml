<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleRow namespace=WeftScreens
<screen id="root" label="Users" weft="0.1">
  <table id="users" label="Users">
    <column id="col-name">Name</column>
    <row id="row-ana" selected="{$.anaSelected}" on-press="users.select">
      <cell id="cell-ana">Ana</cell>
    </row>
  </table>
</screen>
-->
<Page x:Class="WeftScreens.ExampleRowPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Users">
            <StackPanel AutomationProperties.AutomationId="users" AutomationProperties.LocalizedControlType="table" AutomationProperties.Name="Users">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="col-name" AutomationProperties.LocalizedControlType="column header" Content="Name" />
                </Grid>
                <Grid AutomationProperties.AutomationId="row-ana" AutomationProperties.LocalizedControlType="row" weft:Props.Selected="{x:Bind ViewModel.anaSelected, Mode=OneWay}" weft:On.Press="{x:Bind ViewModel.users_selectCommand}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl AutomationProperties.AutomationId="cell-ana" AutomationProperties.LocalizedControlType="cell" Content="Ana" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
