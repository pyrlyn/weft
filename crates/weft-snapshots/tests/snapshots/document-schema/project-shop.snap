    "field": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "field"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "disabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NegatableBinding"
                }
              ],
              "description": "Set to true to make the field non-interactive."
            },
            "error": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "An error message to show for this field; set it when the value is invalid."
            },
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "placeholder": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "Hint text shown while the field is empty; it does not replace the label."
            },
            "required": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NegatableBinding"
                }
              ],
              "description": "Set to true when the user must fill the field in."
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            },
            "state": {
              "anyOf": [
                {
                  "enum": [
                    "valid",
                    "invalid"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "One of the component's states."
            },
            "type": {
              "anyOf": [
                {
                  "enum": [
                    "text",
                    "email",
                    "password",
                    "number",
                    "search",
                    "multiline"
                  ]
                },
