          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "on": {
          "type": "object",
          "properties": {
            "change": {
              "$ref": "#/$defs/Action"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id",
        "props"
      ],
      "additionalProperties": false,
      "description": "A number the user raises or lowers by a fixed step with plus and minus buttons; use it for small counts such as a quantity."
    },
    "switch": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "switch"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "checked": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "Whether the control is on; bind it to a boolean to read and write it."
            },
            "disabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NegatableBinding"
                }
              ],
              "description": "Set to true to make the switch non-interactive."
            },
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "on": {
          "type": "object",
          "properties": {
            "change": {
              "$ref": "#/$defs/Action"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id",
        "props"
      ],
      "additionalProperties": false,
      "description": "A toggle that applies a setting immediately; prefer it over a checkbox for on/off settings."
    },
    "tab": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tab"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Node"
              },
              {
                "$ref": "#/$defs/each:tab"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "id",
        "props"
      ],
      "additionalProperties": false,
      "description": "One panel of a tabs component: its label becomes the tab title and its content the panel."
    },
    "table": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            },
            "state": {
              "anyOf": [
                {
                  "enum": [
                    "ready",
                    "loading",
                    "empty"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "One of the component's states."
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "properties": {
            "empty": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Node"
                  },
                  {
                    "$ref": "#/$defs/column"
                  },
                  {
                    "$ref": "#/$defs/row"
                  },
                  {
                    "$ref": "#/$defs/each:table:empty"
                  }
                ]
              },
              "description": "Content shown instead of the rows when there are none, such as \"No results found\"."
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/column"
              },
              {
                "$ref": "#/$defs/row"
              },
              {
                "$ref": "#/$defs/each:table"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "id",
        "props"
      ],
      "additionalProperties": false,
      "description": "Tabular data with column headers and rows; always give it a label."
    },
    "tabs": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tabs"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            },
            "selected": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The `id` of the selected `tab`; bind it to read and write the active tab."
            }
          },
          "additionalProperties": false
        },
        "on": {
          "type": "object",
          "properties": {
            "change": {
              "$ref": "#/$defs/Action"
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tab"
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "Switches between alternative panels, one visible at a time; each panel is a `tab` child."
    },
    "text": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "text"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            },
            "text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The text to show, given as a value instead of content; bind it when the text comes from data. Never give both."
            },
            "tone": {
              "anyOf": [
                {
                  "enum": [
                    "default",
                    "muted",
                    "success",
                    "warning",
                    "danger"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "Semantic colouring of the text; muted for secondary text, danger for errors."
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "A run of plain text such as a paragraph, caption or message."
    },
    "universal:grow": {
      "type": "boolean",
      "description": "Takes a share of the parent stack's free space."
    },
    "universal:hidden": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/NegatableBinding"
        }
      ],
      "description": "Not rendered and not exposed."
    },
    "universal:label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Binding"
        }
      ],
      "description": "Accessible name."
    },
    "universal:perspective": {
      "type": "number",
      "minimum": 1.0,
      "description": "Viewer distance of a 3D tilt, in px."
    },
    "universal:rotate-x": {
      "type": "number",
      "minimum": -360.0,
      "maximum": 360.0,
      "description": "Rotation about the horizontal axis, in degrees."
    },
    "universal:rotate-y": {
      "type": "number",
      "minimum": -360.0,
      "maximum": 360.0,
      "description": "Rotation about the vertical axis, in degrees."
    },
    "universal:rotate-z": {
      "type": "number",
      "minimum": -360.0,
      "maximum": 360.0,
      "description": "Rotation in the screen plane, in degrees."
    }
  }
}
