    "button": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "button"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "disabled": {
              "anyOf": [
