                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The `max` attribute."
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "precision": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The `precision` attribute."
            },
            "readonly": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NegatableBinding"
                }
              ],
              "description": "The `readonly` attribute."
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The `value` attribute."
            },
            "value-label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
