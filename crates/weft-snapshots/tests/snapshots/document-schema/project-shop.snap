            },
            "max": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The latest allowed value, in the format of `type`."
            },
            "min": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
