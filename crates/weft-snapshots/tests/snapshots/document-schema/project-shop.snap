            },
            "state": {
              "anyOf": [
                {
                  "enum": [
                    "idle",
                    "busy"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "One of the component's states."
            },
            "submit": {
              "type": "boolean",
              "description": "Set to true to make the button submit its enclosing form, firing the form's `submit` event; such a button needs no `on-press`."
            },
            "text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The text to show, given as a value instead of content; bind it when the text comes from data. Never give both."
            },
            "variant": {
              "anyOf": [
                {
                  "enum": [
                    "primary",
                    "secondary",
                    "danger",
                    "ghost"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "Visual emphasis: primary for the main action, danger for destructive ones, ghost for quiet ones."
            }
          },
          "additionalProperties": false
        },
        "on": {
          "type": "object",
          "properties": {
