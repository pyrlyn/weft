            },
            "type": {
              "anyOf": [
                {
                  "enum": [
                    "date",
                    "time",
                    "datetime"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "What is chosen: `date` as yyyy-mm-dd, `time` as hh:mm, `datetime` as yyyy-mm-ddThh:mm."
            },
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The chosen date or time in the format of `type`; bind it to read and write it."
            }
