---
source: crates/weft-snapshots/tests/document_schema.rs
description: the document JSON Schema of project-shop
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A Weft 0.2 document in canonical JSON (SPEC §3) for catalog shop 1.1.0. Checks the validator makes beyond this schema are listed in SPEC §3.1.",
  "type": "object",
  "properties": {
    "weft": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "root": {
      "$ref": "#/$defs/screen"
    }
  },
  "required": [
    "weft",
    "root"
  ],
  "additionalProperties": false,
  "$defs": {
    "Action": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
    },
    "Binding": {
      "type": "object",
      "properties": {
        "bind": {
          "type": "string",
          "pattern": "^\\$(?:(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|0|[1-9][0-9]*))+|[A-Za-z_][A-Za-z0-9_]*(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|0|[1-9][0-9]*))*)$"
        }
      },
      "required": [
        "bind"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "NegatableBinding": {
      "type": "object",
      "properties": {
        "bind": {
          "type": "string",
          "pattern": "^\\$(?:(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|0|[1-9][0-9]*))+|[A-Za-z_][A-Za-z0-9_]*(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|0|[1-9][0-9]*))*)$"
        },
        "not": {
          "const": true
        }
      },
      "required": [
        "bind"
      ],
      "additionalProperties": false
    },
    "Node": {
      "anyOf": [
        {
          "$ref": "#/$defs/acme-badge"
        },
        {
          "$ref": "#/$defs/acme-button"
        },
        {
          "$ref": "#/$defs/acme-card"
        },
        {
          "$ref": "#/$defs/acme-rating"
        },
        {
          "$ref": "#/$defs/alert"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/checkbox"
        },
        {
          "$ref": "#/$defs/color-picker"
        },
        {
          "$ref": "#/$defs/combobox"
        },
        {
          "$ref": "#/$defs/date-picker"
        },
        {
          "$ref": "#/$defs/dialog"
        },
        {
          "$ref": "#/$defs/field"
        },
        {
          "$ref": "#/$defs/form"
        },
        {
          "$ref": "#/$defs/grid"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/menu"
        },
        {
          "$ref": "#/$defs/model"
        },
        {
          "$ref": "#/$defs/radio-group"
        },
        {
          "$ref": "#/$defs/rating"
        },
        {
          "$ref": "#/$defs/section"
        },
        {
          "$ref": "#/$defs/segmented-control"
        },
        {
          "$ref": "#/$defs/select"
        },
        {
          "$ref": "#/$defs/slider"
        },
        {
          "$ref": "#/$defs/stack"
        },
        {
          "$ref": "#/$defs/stepper"
        },
        {
          "$ref": "#/$defs/switch"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/tabs"
        },
        {
          "$ref": "#/$defs/text"
        }
      ]
    },
    "Token": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false
    },
    "acme-badge": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "acme-badge"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "pill": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NegatableBinding"
                }
              ],
              "description": "The `pill` attribute."
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Node"
              },
              {
                "$ref": "#/$defs/each:acme-badge"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "A small status marker."
    },
    "acme-button": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "acme-button"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "disabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NegatableBinding"
                }
              ],
              "description": "The `disabled` attribute."
            },
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "href": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The `href` attribute."
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            },
            "size": {
              "anyOf": [
                {
                  "enum": [
                    "small",
                    "medium",
                    "large"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The `size` attribute."
            },
            "variant": {
              "anyOf": [
                {
                  "enum": [
                    "default",
                    "primary",
                    "danger",
                    "ghost"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "Visual emphasis: primary for the main action, danger for destructive ones, ghost for quiet ones."
            }
          },
          "additionalProperties": false
        },
        "on": {
          "type": "object",
          "properties": {
            "acme-click": {
              "$ref": "#/$defs/Action"
            },
            "acme-focus": {
              "$ref": "#/$defs/Action"
            }
          },
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Node"
                  },
                  {
                    "$ref": "#/$defs/each:acme-button:prefix"
                  }
                ]
              },
              "description": "An icon before the label."
            },
            "suffix": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Node"
                  },
                  {
                    "$ref": "#/$defs/each:acme-button:suffix"
                  }
                ]
              },
              "description": "An icon after the label."
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Node"
              },
              {
                "$ref": "#/$defs/each:acme-button"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "A button."
    },
    "acme-card": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "acme-card"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "elevated": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NegatableBinding"
                }
              ],
              "description": "The `elevated` attribute."
            },
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            }
          },
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "properties": {
            "footer": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Node"
                  },
                  {
                    "$ref": "#/$defs/each:acme-card:footer"
                  }
                ]
              },
              "description": "The footer."
            },
            "header": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Node"
                  },
                  {
                    "$ref": "#/$defs/each:acme-card:header"
                  }
                ]
              },
              "description": "The header."
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Node"
              },
              {
                "$ref": "#/$defs/each:acme-card"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "A surface with an optional header and footer."
    },
    "acme-rating": {
      "type": "object",
      "properties": {
        "kind": {
