      "description": "Chooses a colour; the value is written as a lowercase hex colour such as #3b82f6."
    },
    "column": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "column"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "props": {
          "type": "object",
          "properties": {
            "grow": {
              "$ref": "#/$defs/universal:grow"
            },
            "hidden": {
              "$ref": "#/$defs/universal:hidden"
            },
            "label": {
              "$ref": "#/$defs/universal:label"
            },
            "perspective": {
              "$ref": "#/$defs/universal:perspective"
            },
            "rotate-x": {
              "$ref": "#/$defs/universal:rotate-x"
            },
            "rotate-y": {
              "$ref": "#/$defs/universal:rotate-y"
            },
            "rotate-z": {
              "$ref": "#/$defs/universal:rotate-z"
            },
            "sort": {
              "anyOf": [
                {
                  "enum": [
                    "none",
                    "ascending",
                    "descending"
                  ]
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The sort direction currently applied to this column."
            },
            "text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ],
              "description": "The text to show, given as a value instead of content; bind it when the text comes from data. Never give both."
            }
          },
          "additionalProperties": false
        },
        "on": {
          "type": "object",
          "properties": {
            "press": {
              "$ref": "#/$defs/Action"
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "A column header of a table; its content is the header text."
    },
    "combobox": {
